# Backend de pagos NOWPayments — variables de entorno (Render → Environment)
# NO comitear el .env real.

# --- NOWPayments ---
# Panel → Settings → API keys / IPN secret.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# URL pública de ESTE servicio. Se usa para construir el ipn_callback_url que
# se manda a NOWPayments, así que tiene que ser exacta y accesible por internet.
PUBLIC_BASE_URL=https://bot2strp.onrender.com

# --- Supabase ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Tokens de Telegram (uno por proyecto de BOT_CONFIGS) ---
BOT_TOKEN_MONKEY=
BOT_TOKEN_V2V=
TG_USERNAME_V2V=videosSound151666bot
BOT_TOKEN_IMG=
TG_USERNAME_IMG=imagenesmonkey994bot

# text_2_videos: usa el token del BOT PRINCIPAL para avisar que el pago cripto
# se acreditó. El username puede ser el nuevo bot de Stars y se usa como URL de
# regreso al terminar el checkout.
BOT_TOKEN_T2V2=
TG_USERNAME_T2V2=
